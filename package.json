{
  "name": "event-booking-system-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade scalable and reliable Event Booking System API with RBAC, atomic concurrency control, and async background job queues.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:render": "node -e \"require('fs').copyFileSync('prisma/schema.postgres.prisma', 'prisma/schema.prisma')\" && npx prisma generate && npm run build",
    "start": "node dist/server.js",
    "start:render": "npx prisma db push && npx tsx prisma/seed.ts && npm start",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest --config jest.config.cjs --runInBand --detectOpenHandles",
    "test:stress": "tsx scripts/stress-test.ts",
    "test:stress:naive": "tsx scripts/stress-test.ts --mode naive --concurrency 100",
    "test:stress:optimized": "tsx scripts/stress-test.ts --mode optimized --concurrency 500"
  },
  "keywords": [
    "event-booking",
    "high-concurrency",
    "distributed-systems",
    "bullmq",
    "redis",
    "resend",
    "enterprise"
  ],
  "author": "Aman Lajpal <lajpalaman1314@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "resend": "^4.0.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/yamljs": "^0.2.34",
    "autocannon": "^7.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}
