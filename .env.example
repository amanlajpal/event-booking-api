# Application
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (SQLite for local dev, PostgreSQL for production/cloud)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/eventbooking?schema=public"

# Redis & Background Queue (BullMQ)
REDIS_URL="redis://127.0.0.1:6379"

# Security & Authentication
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Real Email Service
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Concurrency & Booking Engine Mode: "optimized" | "naive"
CONCURRENCY_MODE=optimized
