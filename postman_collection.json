{
  "info": {
    "name": "Event Booking System API",
    "description": "Enterprise-grade Event Booking System with RBAC, High Concurrency Controls, and BullMQ Background Queue with real email delivery.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "b9ae6005-9b5a-4123-b8be-b9cfda246699",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "2. Auth - Login as Organizer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('orgToken', jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"organizer@events.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Auth - Login as Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('custToken', jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"lajpalaman1314@gmail.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "4. Events - List All Events (Public Discovery)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"]
        }
      }
    },
    {
      "name": "5. Events - Create Event (Organizer Only)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{orgToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Distributed Systems World 2026\",\n  \"description\": \"Comprehensive summit covering microservices, caching, and concurrency resilience.\",\n  \"location\": \"San Francisco Convention Center\",\n  \"eventDate\": \"2026-12-28T10:00:00Z\",\n  \"totalTickets\": 100,\n  \"ticketPrice\": 89.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"]
        }
      }
    },
    {
      "name": "6. Events - Book Ticket (Customer Only -> Triggers Background Task 1: Real Email)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{custToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/book",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "{{eventId}}", "book"]
        }
      }
    },
    {
      "name": "7. Events - Update Event (Organizer Only -> Triggers Background Task 2: Notification Fanout)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{orgToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"location\": \"Grand Ballroom - Main Stage VIP Room\",\n  \"description\": \"Keynote speaker lineup updated with top industry leaders.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "{{eventId}}"]
        }
      }
    },
    {
      "name": "8. Events - View Bookings for Event (Organizer Only)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{orgToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/bookings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "{{eventId}}", "bookings"]
        }
      }
    },
    {
      "name": "9. Bookings - View My Bookings (Customer Only)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{custToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bookings/my-bookings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "bookings", "my-bookings"]
        }
      }
    }
  ]
}
